# Network: anvil-fork | sepolia | arbitrum | base
NETWORK=base
DRY_RUN=true

# RPC endpoints
BASE_RPC_URL=
ARBITRUM_RPC_URL=
SEPOLIA_RPC_URL=

# Receiver contract addresses
BASE_CONTRACT_ADDRESS=
ARBITRUM_CONTRACT_ADDRESS=
CONTRACT_ADDRESS=

# Dedicated hot wallet. Never commit this file.
PRIVATE_KEY=

# Manual executor (disabled by default)
EXECUTOR_ENABLED=false
EXECUTOR_TOKEN=
ENABLE_LIVE_EXECUTION=false

# Strategy
MIN_LIQUIDITY_USD=100000
POOL_PCT=0.01
MIN_LOAN_WETH=0.05
MAX_LOAN_WETH=5
GAS_ESTIMATE_UNITS=450000
PROFIT_SAFETY_MULTIPLIER=2
MIN_PROFIT_FLOOR_WETH=0.001
MIN_NET_PROFIT_WETH=0.0005
SLIPPAGE_BUFFER_BPS=100
EXPECTED_SLIPPAGE_BPS=20

# Leave blank to use the network default (USDC on Base; USDC.e on Arbitrum)
QUOTE_TOKEN=

# Optional SQLite path override
BOT_DB_PATH=
