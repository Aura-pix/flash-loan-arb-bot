# Network: base | arbitrum | sepolia | anvil-fork
NETWORK=base

# RPC endpoints
BASE_RPC_URL=
ARBITRUM_RPC_URL=
SEPOLIA_RPC_URL=

# Dedicated deployer wallet. Never commit this file.
PRIVATE_KEY=

# Receiver addresses (after deployment)
BASE_CONTRACT_ADDRESS=
ARBITRUM_CONTRACT_ADDRESS=
CONTRACT_ADDRESS=

# Deploy safety: set to 1 to allow a mainnet deployment
CONFIRM_DEPLOY=

# Optional V2 venue overrides. Accepts a venue id (e.g. uniswap-v2) or a router address.
DEX_A=
DEX_B=

MIN_LIQUIDITY_USD=100000
GAS_ESTIMATE_UNITS=450000
